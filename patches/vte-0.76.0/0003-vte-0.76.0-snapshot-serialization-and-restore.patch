+/* ---------------- Phase 0C snapshot helpers (internal state serialization) ----------------
+ *
+ * This is an INTERNAL PROTOTYPE used to demonstrate that VTE's full emulator state
+ * can be captured into an opaque binary snapshot and restored directly (no text/HTML/
+ * ANSI replay). The format captures the *semantic terminal state*:
+ *
+ *   geometry, scrollback, cursor shape, modes, palette, defaults, character
+ *   replacement map, scrolling region (DECSTBM/DECSLRM), tabstops, BOTH screens
+ *   (normal + alternate) including cursor, saved-cursor block, insert/scroll deltas,
+ *   and the full ring contents (per-cell text/attr/colors/hyperlinks).
+ *
+ * Ring rows are rebuilt from the per-cell data; ring *streams* are regenerated by VTE
+ * itself when rows freeze again after the restore, so streams are NOT serialized.
+ */
+
+namespace {
+
+#if VTE_DEBUG
+#define SNPSHOT_ASSERT(x) g_assert(x)
+#else
+#define SNPSHOT_ASSERT(x) ((void)0)
+#endif
+
+#define SNAPSHOT_MAGIC   0x56534E50u /* "VSNP" */
+#define SNAPSHOT_VERSION 3u
+
+static void
+snp_put_u8(GByteArray *b, guint8 v) { g_byte_array_append(b, &v, 1); }
+
+static void
+snp_put_u16(GByteArray *b, guint16 v)
+{
+        guint8 c[2] = { guint8(v >> 8), guint8(v & 0xff) };
+        g_byte_array_append(b, c, 2);
+}
+
+static void
+snp_put_u32(GByteArray *b, guint32 v)
+{
+        guint8 c[4] = { guint8(v >> 24), guint8(v >> 16), guint8(v >> 8), guint8(v) };
+        g_byte_array_append(b, c, 4);
+}
+
+static void
+snp_put_u64(GByteArray *b, guint64 v)
+{
+        guint8 c[8];
+        for (int i = 0; i < 8; i++)
+                c[i] = guint8(v >> (56 - 8 * i));
+        g_byte_array_append(b, c, 8);
+}
+
+static void
+snp_put_i64(GByteArray *b, gint64 v) { snp_put_u64(b, guint64(v)); }
+
+static void
+snp_put_f64(GByteArray *b, double v)
+{
+        guint64 u;
+        memcpy(&u, &v, sizeof(u));
+        snp_put_u64(b, u);
+}
+
+static void
+snp_put_bytes(GByteArray *b, const void *p, gsize n)
+{
+        g_byte_array_append(b, static_cast<const guint8*>(p), n);
+}
+
+struct SnpReader {
+        const guint8 *d;
+        gsize n;
+        gsize o{0};
+        bool ok{true};
+
+        SnpReader(const guint8 *data, gsize size) : d(data), n(size) {}
+
+        bool get_u8(guint8 &v)
+        {
+                if (o + 1 > n) { ok = false; return false; }
+                v = d[o++];
+                return true;
+        }
+        bool get_u16(guint16 &v)
+        {
+                if (o + 2 > n) { ok = false; return false; }
+                v = guint16((guint16(d[o]) << 8) | guint16(d[o + 1]));
+                o += 2;
+                return true;
+        }
+        bool get_u32(guint32 &v)
+        {
+                if (o + 4 > n) { ok = false; return false; }
+                v = (guint32(d[o]) << 24) | (guint32(d[o + 1]) << 16) | (guint32(d[o + 2]) << 8) | guint32(d[o + 3]);
+                o += 4;
+                return true;
+        }
+        bool get_u64(guint64 &v)
+        {
+                if (o + 8 > n) { ok = false; return false; }
+                v = 0;
+                for (int i = 0; i < 8; i++)
+                        v = (v << 8) | d[o + i];
+                o += 8;
+                return true;
+        }
+        bool get_i64(gint64 &v)
+        {
+                guint64 u;
+                if (!get_u64(u)) return false;
+                v = gint64(u);
+                return true;
+        }
+        bool get_f64(double &v)
+        {
+                guint64 u;
+                if (!get_u64(u)) return false;
+                memcpy(&v, &u, sizeof(v));
+                return true;
+        }
+        bool get_bytes(void *p, gsize len)
+        {
+                if (o + len > n) { ok = false; return false; }
+                if (len > 0)
+                        memcpy(p, d + o, len);
+                o += len;
+                return true;
+        }
+        bool get_cstr(std::string &s)
+        {
+                guint16 len;
+                if (!get_u16(len)) return false;
+                if (o + len > n) { ok = false; return false; }
+                s.assign(reinterpret_cast<const char*>(d + o), len);
+                o += len;
+                return true;
+        }
+};
+
+/* Serialize the 16-byte-hot fields of a cell. Hyperlinks are handled with the
+ * ring as the owner (capture: URL string; restore: re-registered idx). */
+static void
+snp_put_cell(GByteArray *b, VteCell const& cell)
+{
+        snp_put_u32(b, guint32(cell.c));
+        snp_put_u32(b, cell.attr.attr);
+        snp_put_u64(b, cell.attr.m_colors);
+}
+
+static void
+snp_put_cell_with_hyperlink_idx(GByteArray *b, VteCell const& cell)
+{
+        snp_put_u32(b, guint32(cell.c));
+        snp_put_u32(b, cell.attr.attr);
+        snp_put_u64(b, cell.attr.m_colors);
+        /* hyperlink handled by caller via get_hyperlink_at_position() */
+}
+
+static bool
+snp_get_cell(SnpReader &r, VteCell *cell, uint32_t hlink_idx)
+{
+        guint32 c, attr;
+        guint64 colors;
+        if (!r.get_u32(c) || !r.get_u32(attr) || !r.get_u64(colors))
+                return false;
+        *cell = basic_cell;
+        cell->c = vteunistr(c);
+        cell->attr.attr = attr;
+        cell->attr.m_colors = colors;
+        cell->attr.hyperlink_idx = hlink_idx;
+        return true;
+}
+
+/* ---- ring row serialization ----
+ * Rows are iterated [delta, next). Frozen rows are deep-copied via
+ * _vte_row_data_copy before serialization and hyperlink strings are resolved
+ * through get_hyperlink_at_position() (handles frozen+writable uniformly).
+ */
+static void
+snp_put_ring_rows(GByteArray *b, vte::base::Ring *ring)
+{
+        auto const start = ring->delta();
+        auto const end = ring->next();
+        snp_put_u32(b, guint32(end - start));
+
+        for (auto pos = start; pos < end; pos++) {
+                const VteRowData *src = ring->index(pos);
+                VteRowData row;
+                _vte_row_data_init(&row);
+                _vte_row_data_copy(src, &row);
+
+                snp_put_u16(b, guint16(row.len));
+                snp_put_u8(b, row.attr.soft_wrapped ? 1 : 0);
+                snp_put_u8(b, row.attr.bidi_flags);
+
+                for (guint col = 0; col < row.len; col++) {
+                        VteCell const& cell = row.cells[col];
+                        snp_put_cell_with_hyperlink_idx(b, cell);
+                        /* Resolve the hyperlink URL string (works for frozen + writable). */
+                        char const *url = nullptr;
+                        ring->get_hyperlink_at_position(pos, col, false, &url);
+                        if (url == nullptr) {
+                                snp_put_u8(b, 0);
+                        } else {
+                                snp_put_u8(b, 1);
+                                gsize ulen = strlen(url);
+                                SNPSHOT_ASSERT(ulen <= G_MAXUINT16);
+                                snp_put_u16(b, guint16(ulen));
+                                snp_put_bytes(b, url, ulen);
+                        }
+                }
+                _vte_row_data_fini(&row);
+        }
+}
+
+static bool
+snp_get_ring_rows(SnpReader &r, vte::base::Ring *ring)
+{
+        guint32 rows;
+        if (!r.get_u32(rows))
+                return false;
+
+        for (guint32 i = 0; i < rows; i++) {
+                guint16 len;
+                guint8 soft_wrapped, bidi_flags;
+                if (!r.get_u16(len) || !r.get_u8(soft_wrapped) || !r.get_u8(bidi_flags))
+                        return false;
+
+                VteRowData *row = ring->append(bidi_flags);
+                row->attr.soft_wrapped = soft_wrapped != 0;
+
+                for (guint col = 0; col < len; col++) {
+                        guint32 c, attr;
+                        guint64 colors;
+                        guint8 has_hlink;
+                        std::string url;
+                        if (!r.get_u32(c) || !r.get_u32(attr) || !r.get_u64(colors) ||
+                            !r.get_u8(has_hlink))
+                                return false;
+
+                        uint32_t hlink_idx = 0;
+                        if (has_hlink) {
+                                if (!r.get_cstr(url))
+                                        return false;
+                                hlink_idx = ring->get_hyperlink_idx(url.c_str());
+                        }
+
+                        VteCell cell = basic_cell;
+                        cell.c = vteunistr(c);
+                        cell.attr.attr = attr;
+                        cell.attr.m_colors = colors;
+                        cell.attr.hyperlink_idx = hlink_idx;
+                        _vte_row_data_append(row, &cell);
+                }
+                _vte_row_data_nonempty_length(row);
+        }
+        return true;
+}
+
+} // anonymous namespace
+
+/**
+ * Terminal::snapshot_capture:
+ * @snapshot_data: (out) (transfer full): a #GBytes to store the snapshot data
+ *
+ * Captures the full internal emulator state of the terminal (geometry, modes,
+ * palette, defaults, scrolling region, tabstops, both screens with cursor/saved
+ * blocks and full ring content incl. hyperlinks) into an opaque binary snapshot.
+ *
+ * Returns: %TRUE on success, %FALSE on failure
+ */
+gboolean
+Terminal::snapshot_capture(GBytes **snapshot_data)
+{
+        if (snapshot_data == nullptr)
+                return FALSE;
+
+        GByteArray *b = g_byte_array_new();
+
+        /* ---- header ---- */
+        snp_put_u32(b, SNAPSHOT_MAGIC);
+        snp_put_u32(b, SNAPSHOT_VERSION);
+        snp_put_u32(b, guint32(m_row_count));
+        snp_put_u32(b, guint32(m_column_count));
+        snp_put_u32(b, guint32(m_scrollback_lines));
+        snp_put_u32(b, guint32(m_cursor_shape));
+        snp_put_u8(b, m_screen == &m_alternate_screen ? 1 : 0);
+
+        /* ---- modes ---- */
+        snp_put_u8(b, guint8(m_modes_ecma.get_modes()));
+        snp_put_u32(b, guint32(m_modes_private.get_modes()));
+
+        /* ---- palette ---- */
+        snp_put_u16(b, VTE_PALETTE_SIZE);
+        for (guint i = 0; i < VTE_PALETTE_SIZE; i++) {
+                VtePaletteColor const& e = m_palette[i];
+                for (int j = 0; j < 2; j++) {
+                        snp_put_u8(b, e.sources[j].is_set ? 1 : 0);
+                        snp_put_u16(b, e.sources[j].color.red);
+                        snp_put_u16(b, e.sources[j].color.green);
+                        snp_put_u16(b, e.sources[j].color.blue);
+                }
+        }
+
+        /* ---- additional terminal flags ---- */
+        snp_put_u8(b, m_bidi_rtl ? 1 : 0);
+        snp_put_u8(b, m_allow_hyperlink ? 1 : 0);
+        snp_put_u32(b, guint32(m_mouse_tracking_mode));
+        snp_put_u32(b, guint32(m_utf8_ambiguous_width));
+
+        /* ---- terminal-wide defaults & character replacements ---- */
+        snp_put_cell(b, m_defaults);
+        snp_put_cell(b, m_color_defaults);
+        snp_put_u8(b, m_character_replacements[0]);
+        snp_put_u8(b, m_character_replacements[1]);
+        snp_put_u8(b, m_character_replacement == &m_character_replacements[1] ? 1 : 0);
+
+        /* ---- scrolling region (DECSTBM/DECSLRM) ---- */
+        snp_put_u8(b, m_scrolling_region.is_restricted() ? 1 : 0);
+        snp_put_u32(b, guint32(m_scrolling_region.top()));
+        snp_put_u32(b, guint32(m_scrolling_region.bottom()));
+        snp_put_u32(b, guint32(m_scrolling_region.left()));
+        snp_put_u32(b, guint32(m_scrolling_region.right()));
+
+        /* ---- tabstops ---- */
+        guint32 tc = guint32(m_column_count);
+        snp_put_u32(b, tc);
+        for (guint32 i = 0; i < tc; i++)
+                snp_put_u8(b, m_tabstops.get(i) ? 1 : 0);
+
+        /* ---- screens ---- */
+        for (VteScreen *screen : { &m_normal_screen, &m_alternate_screen }) {
+                auto ring = screen->row_data;
+
+                /* positions relative to ring delta => restore works regardless of delta */
+                snp_put_i64(b, gint64(screen->insert_delta - ring->delta()));
+                snp_put_f64(b, screen->scroll_delta - ring->delta());
+                snp_put_i64(b, gint64(screen->cursor.row - ring->delta()));
+                snp_put_i64(b, gint64(screen->cursor.col));
+                snp_put_u8(b, screen->cursor_advanced_by_graphic_character ? 1 : 0);
+
+                /* saved-cursor block */
+                snp_put_i64(b, gint64(screen->saved.cursor.row));    /* relative to insert_delta */
+                snp_put_i64(b, gint64(screen->saved.cursor.col));
+                snp_put_u8(b, screen->saved.cursor_advanced_by_graphic_character ? 1 : 0);
+                snp_put_u8(b, screen->saved.reverse_mode ? 1 : 0);
+                snp_put_u8(b, screen->saved.origin_mode ? 1 : 0);
+                snp_put_cell(b, screen->saved.defaults);
+                snp_put_cell(b, screen->saved.color_defaults);
+                snp_put_u8(b, screen->saved.character_replacements[0]);
+                snp_put_u8(b, screen->saved.character_replacements[1]);
+                snp_put_u8(b, screen->saved.character_replacement == &screen->saved.character_replacements[1] ? 1 : 0);
+
+                /* ring contents */
+                snp_put_ring_rows(b, ring);
+        }
+
+        GBytes *out = g_bytes_new(b->data, b->len);
+        g_byte_array_free(b, TRUE);
+
+        *snapshot_data = out;
+        return TRUE;
+}
+
+/**
+ * Terminal::snapshot_restore:
+ * @snapshot_data: a #GBytes containing the snapshot data
+ *
+ * Restores the full terminal internal state from a previously captured snapshot,
+ * rebuilding both screen rings from per-cell data and reapplying every semantic
+ * field (modes, palette, defaults, region, tabstops, cursor/saved blocks).
+ *
+ * Returns: %TRUE on success, %FALSE on failure
+ */
+gboolean
+Terminal::snapshot_restore(GBytes *snapshot_data)
+{
+        if (snapshot_data == nullptr)
+                return FALSE;
+
+        gsize snapshot_size;
+        const guint8 *data = static_cast<const guint8*>(g_bytes_get_data(snapshot_data, &snapshot_size));
+        SnpReader r(data, snapshot_size);
+
+        /* ---- header ---- */
+        guint32 magic, version;
+        if (!r.get_u32(magic) || magic != SNAPSHOT_MAGIC) {
+                g_printerr("SNAP restore: magic fail (%08x)\n", magic);
+                return FALSE;
+        }
+        if (!r.get_u32(version) || version != SNAPSHOT_VERSION) {
+                g_printerr("SNAP restore: version fail (%08x)\n", version);
+                return FALSE;
+        }
+
+        guint32 rows, cols, scrollback_lines, cursor_shape;
+        guint8 active_screen;
+        if (!r.get_u32(rows) || !r.get_u32(cols) ||
+            !r.get_u32(scrollback_lines) || !r.get_u32(cursor_shape) ||
+            !r.get_u8(active_screen)) {
+                g_printerr("SNAP restore: header read fail (off=%zu/%zu)\n", r.o, r.n);
+                return FALSE;
+        }
+        if (rows == 0 || cols == 0) {
+                g_printerr("SNAP restore: dims fail rows=%u cols=%u\n", rows, cols);
+                return FALSE;
+        }
+
+        /* ---- modes ---- */
+        guint8 modes_ecma;
+        guint32 modes_private;
+        if (!r.get_u8(modes_ecma) || !r.get_u32(modes_private)) {
+                g_printerr("SNAP restore: modes read fail off=%zu/%zu\n", r.o, r.n);
+                return FALSE;
+        }
+
+        /* ---- palette ---- */
+        guint16 pal_count;
+        if (!r.get_u16(pal_count) || pal_count != VTE_PALETTE_SIZE) {
+                g_printerr("SNAP restore: palette count fail got=%u off=%zu/%zu\n", pal_count, r.o, r.n);
+                return FALSE;
+        }
+        for (guint i = 0; i < VTE_PALETTE_SIZE; i++) {
+                VtePaletteColor& e = m_palette[i];
+                for (int j = 0; j < 2; j++) {
+                        guint8 is_set;
+                        guint16 rr, gg, bb;
+                        if (!r.get_u8(is_set) || !r.get_u16(rr) || !r.get_u16(gg) || !r.get_u16(bb))
+                                return FALSE;
+                        e.sources[j].is_set = is_set != 0;
+                        e.sources[j].color.red = rr;
+                        e.sources[j].color.green = gg;
+                        e.sources[j].color.blue = bb;
+                }
+        }
+
+        /* ---- additional terminal flags ---- */
+        guint8 bidi_rtl, allow_hyperlink;
+        guint32 mouse_tracking_mode, utf8_ambiguous_width;
+        if (!r.get_u8(bidi_rtl) || !r.get_u8(allow_hyperlink) ||
+            !r.get_u32(mouse_tracking_mode) || !r.get_u32(utf8_ambiguous_width)) {
+                g_printerr("SNAP restore: additional flags read fail off=%zu/%zu\n", r.o, r.n);
+                return FALSE;
+        }
+        m_bidi_rtl = bidi_rtl != 0;
+        m_allow_hyperlink = allow_hyperlink != 0;
+        m_mouse_tracking_mode = (MouseTrackingMode)mouse_tracking_mode;
+        m_utf8_ambiguous_width = (int)utf8_ambiguous_width;
+
+        /* ---- terminal-wide defaults & character replacements ---- */
+        VteCell term_defaults, term_color_defaults;
+        if (!snp_get_cell(r, &term_defaults, 0) || !snp_get_cell(r, &term_color_defaults, 0)) {
+                g_printerr("SNAP restore: defaults read fail off=%zu/%zu\n", r.o, r.n);
+                return FALSE;
+        }
+        guint8 char_rep0, char_rep1, char_rep_idx;
+        if (!r.get_u8(char_rep0) || !r.get_u8(char_rep1) || !r.get_u8(char_rep_idx)) {
+                g_printerr("SNAP restore: charreps read fail off=%zu/%zu\n", r.o, r.n);
+                return FALSE;
+        }
+
+        /* ---- scrolling region ---- */
+        guint8 region_restricted;
+        guint32 region_top, region_bottom, region_left, region_right;
+        if (!r.get_u8(region_restricted)) {
+                g_printerr("SNAP restore: region flag read fail off=%zu/%zu\n", r.o, r.n);
+                return FALSE;
+        }
+        /* Capture always serializes the 4 coords (their values are irrelevant
+         * when the region is unrestricted); consume them symmetrically. */
+        if (!r.get_u32(region_top) || !r.get_u32(region_bottom) ||
+            !r.get_u32(region_left) || !r.get_u32(region_right)) {
+                g_printerr("SNAP restore: region read fail off=%zu/%zu\n", r.o, r.n);
+                return FALSE;
+        }
+
+        /* ---- tabstops ---- */
+        guint32 tc;
+        if (!r.get_u32(tc) || tc != guint32(cols)) {
+                g_printerr("SNAP restore: tabcount fail tc=%u cols=%u off=%zu/%zu\n", tc, cols, r.o, r.n);
+                return FALSE;
+        }
+        std::vector<uint8_t> tabs;
+        tabs.resize(tc);
+        for (guint32 i = 0; i < tc; i++) {
+                guint8 v;
+                if (!r.get_u8(v))
+                        return FALSE;
+                tabs[i] = v;
+        }
+
+        /* ---- screens: read straight into per-screen locals below ---- */
+
+        /* ---- apply geometry rollback-able: do settings first (set_size resets modes/region) ---- */
+        set_size(cols, rows, false);
+        set_scrollback_lines(scrollback_lines);
+
+        /* Reapply modes */
+        m_modes_ecma.set_modes(modes_ecma);
+        m_modes_private.set_modes(modes_private);
+
+        m_cursor_shape = CursorShape(cursor_shape);
+        m_defaults = term_defaults;
+        m_color_defaults = term_color_defaults;
+        m_character_replacements[0] = VteCharacterReplacement(char_rep0);
+        m_character_replacements[1] = VteCharacterReplacement(char_rep1);
+        m_character_replacement = char_rep_idx ? &m_character_replacements[1] : &m_character_replacements[0];
+
+        if (region_restricted) {
+                m_scrolling_region.set_vertical(region_top, region_bottom);
+                m_scrolling_region.set_horizontal(region_left, region_right);
+        } else {
+                m_scrolling_region.reset();
+        }
+
+        for (guint32 i = 0; i < tc; i++)
+                tabs[i] ? m_tabstops.set(i) : m_tabstops.unset(i);
+
+        /* ---- rebuild screens ---- */
+        for (VteScreen *screen : { &m_normal_screen, &m_alternate_screen }) {
+                auto ring = screen->row_data;
+
+                gint64 insert_rel, cur_row_rel, cur_col;
+                double scroll_rel;
+                guint8 cur_adv;
+                if (!r.get_i64(insert_rel) || !r.get_f64(scroll_rel) ||
+                    !r.get_i64(cur_row_rel) || !r.get_i64(cur_col) || !r.get_u8(cur_adv)) {
+                        g_printerr("SNAP restore: screen header read fail (screen=%s)\n",
+                                   screen == &m_normal_screen ? "normal" : "alt");
+                        return FALSE;
+                }
+
+                gint64 sav_row, sav_col;
+                guint8 sav_adv, sav_rev, sav_org;
+                VteCell sav_defaults, sav_color_defaults;
+                guint8 sav_rep0, sav_rep1, sav_rep_idx;
+                if (!r.get_i64(sav_row) || !r.get_i64(sav_col) ||
+                    !r.get_u8(sav_adv) || !r.get_u8(sav_rev) || !r.get_u8(sav_org) ||
+                    !snp_get_cell(r, &sav_defaults, 0) || !snp_get_cell(r, &sav_color_defaults, 0) ||
+                    !r.get_u8(sav_rep0) || !r.get_u8(sav_rep1) || !r.get_u8(sav_rep_idx)) {
+                        g_printerr("SNAP restore: saved-block read fail (screen=%s)\n",
+                                   screen == &m_normal_screen ? "normal" : "alt");
+                        return FALSE;
+                }
+
+                /* Clear the ring; append() will re-add rows contiguously from the
+                 * current m_start/m_end (delta stays; relative coords absorb it). */
+                ring->reset();
+
+                if (!snp_get_ring_rows(r, ring)) {
+                        g_printerr("SNAP restore: ring rows read fail (screen=%s)\n",
+                                   screen == &m_normal_screen ? "normal" : "alt");
+                        return FALSE;
+                }
+
+                ring->set_visible_rows(m_row_count);
+
+                auto const delta = ring->delta();
+                screen->insert_delta = long(insert_rel) + delta;
+                screen->scroll_delta = scroll_rel + delta;
+                screen->cursor.row = long(cur_row_rel) + delta;
+                screen->cursor.col = long(cur_col);
+                screen->cursor_advanced_by_graphic_character = cur_adv != 0;
+
+                screen->saved.cursor.row = long(sav_row);
+                screen->saved.cursor.col = long(sav_col);
+                screen->saved.cursor_advanced_by_graphic_character = sav_adv != 0;
+                screen->saved.reverse_mode = sav_rev != 0;
+                screen->saved.origin_mode = sav_org != 0;
+                screen->saved.defaults = sav_defaults;
+                screen->saved.color_defaults = sav_color_defaults;
+                screen->saved.character_replacements[0] = VteCharacterReplacement(sav_rep0);
+                screen->saved.character_replacements[1] = VteCharacterReplacement(sav_rep1);
+                screen->saved.character_replacement =
+                        sav_rep_idx ? &screen->saved.character_replacements[1]
+                                    : &screen->saved.character_replacements[0];
+        }
+
+        m_screen = active_screen ? &m_alternate_screen : &m_normal_screen;
+
+        /* Only the active screen's ring has streams in the original; VTE will
+         * regenerate streams naturally as new rows freeze after this restore. */
+        if (!r.ok) {
+                g_printerr("SNAP restore: reader exhausted early, off=%zu/%zu\n", r.o, r.n);
+                return FALSE;
+        }
+
+        m_contents_changed_pending = TRUE;
+        m_cursor_moved_pending = TRUE;
+        adjust_adjustments_full();
+        invalidate_all();
+
+        return TRUE;
+}
+
+/**
+ * Terminal::snapshot_debug:
+ *
+ * Returns a compact human-readable dump of the current internal state; used by
+ * the Phase 0C prototype to eyeball capture/restore round-trips.
+ */
+std::string
+Terminal::snapshot_debug()
+{
+        std::string s;
+        s.reserve(256);
+        s += "active=";
+        s += (m_screen == &m_alternate_screen) ? "alt" : "normal";
+        s += " dims=" + std::to_string(long(m_row_count)) + "x" + std::to_string(long(m_column_count));
+        s += " scrb=" + std::to_string(long(m_scrollback_lines));
+        s += " cursor=(" + std::to_string(long(m_screen->cursor.row)) + "," + std::to_string(long(m_screen->cursor.col)) + ")";
+        s += " ins=" + std::to_string(long(m_screen->insert_delta));
+        s += " scroll=" + std::to_string(m_screen->scroll_delta);
+        s += " norm_rows=" + std::to_string(unsigned(m_normal_screen.row_data->next() - m_normal_screen.row_data->delta()));
+        s += " alt_rows=" + std::to_string(unsigned(m_alternate_screen.row_data->next() - m_alternate_screen.row_data->delta()));
+        s += " modes0x" + std::to_string(unsigned(m_modes_ecma.get_modes()));
+        s += "/0x" + std::to_string(unsigned(m_modes_private.get_modes()));
+        return s;
+}
+
+gboolean
+Terminal::snapshot_has_pending_data(VteTerminal *terminal)
+{
+    // For now, always return TRUE since we don't track dirty state
+    // In a full implementation, this would check if there are unsaved changes
+    return TRUE;
+}
